APP_ENV=development
WEB_PORT=23000
API_PORT=28000
POSTGRES_PORT=25432
REDIS_PORT=26379
MINIO_API_PORT=29000
MINIO_CONSOLE_PORT=29001

APP_BASE_URL=http://localhost:23000
API_BASE_URL=http://localhost:28000
NEXT_PUBLIC_API_BASE_URL=http://localhost:28000

# Database & Queue
DATABASE_URL=postgresql+psycopg://gsl:gsl_dev_password@localhost:25432/golf_swing_lab
REDIS_URL=redis://localhost:26379/0

# Object Storage (S3 / MinIO)
STORAGE_PROVIDER=s3
S3_ENDPOINT_URL=http://localhost:29000
S3_INTERNAL_ENDPOINT_URL=http://localhost:29000
S3_REGION=us-east-1
S3_BUCKET=golf-swing-lab
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin123
S3_FORCE_PATH_STYLE=true
PRESIGNED_URL_TTL_SECONDS=900

# Auth & Security
SESSION_SECRET=change-me-in-production-at-least-32-bytes-long-secret-key
ADMIN_EMAIL=golfer@swinglab.local
ADMIN_PASSWORD=GolfSwingLab!2026
ALLOWED_ORIGINS=http://localhost:23000,http://127.0.0.1:23000

# Limits & Worker
MAX_UPLOAD_BYTES=8589934592
MAX_VIDEO_DURATION_SEC=1800
WORKER_CONCURRENCY=1
RQ_JOB_TIMEOUT_SEC=3600
ANALYSIS_MODEL_VERSION=pose-v1
SCORING_VERSION=score-v1
DATA_RETENTION_DAYS=30

# Optional LLM Coach Provider (core system works with 'none')
LLM_PROVIDER=none
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_MAX_BUDGET_USD=0
